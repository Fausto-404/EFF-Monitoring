# ==========================================
# EFF-Monitoring v2.2.2  环境变量配置模板
# ==========================================
# 使用方法: cp .env.example .env  然后按需修改敏感值
# Docker 部署需要 .env 文件存在，不能跳过。
# 注意: 本模板用于开发/测试环境；生产环境务必替换默认密码和密钥。
# 本文件仅包含后端/数据库相关变量，前端构建变量请单独配置。
# ==========================================

# --- 镜像说明 ---
# install.sh/deploy.sh 只使用离线镜像包；docker compose up -d --build 可从源码构建应用镜像。
EFF_API_IMAGE=eff-monitoring-api:v2.2.2
EFF_WORKER_IMAGE=eff-monitoring-worker:v2.2.2
EFF_WEB_IMAGE=eff-monitoring-web:v2.2.2

# --- 数据库 ---
# PostgreSQL 超级用户密码（首次初始化后，修改此值需重建数据卷）
POSTGRES_PASSWORD=eff_password
# Docker Compose 根据 POSTGRES_PASSWORD 自动生成 DATABASE_URL；如需外部数据库再显式配置。
REDIS_URL=redis://eff-redis:6379/0

# --- 安全密钥（生产环境务必修改！）---
# JWT_SECRET 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-a-long-random-secret
INITIAL_ADMIN_PASSWORD=admin123

# --- 可选配置 ---
INITIAL_ADMIN_USERNAME=admin
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
APP_TIMEZONE=Asia/Shanghai
# 可选联动封堵：另行生成 32 字节以上随机令牌，并使用 --profile auto-block 启动隔离执行容器。
# BLOCK_RUNNER_TOKEN=
# 可选：提供给联动脚本调用设备 API 的密钥。不要将真实密钥写入脚本或提交到 Git。
# BLOCK_DEVICE_TOKEN=
# 多设备可改用 JSON 映射（键为设备 ID，值为对应 API 令牌），脚本仍只读取 BLOCK_DEVICE_TOKEN。
# BLOCK_DEVICE_TOKENS_JSON={"19":"replace-with-device-token"}

# --- 演示数据 ---
ENABLE_DEMO_DATA=false
# DEMO_USER_PASSWORD=demo123456
